{
  "name": "vscode-swirl",
  "displayName": "Swirl Intermediate Language Support",
  "description": "Rich language support for the Swirl intermediate language (.swirl) featuring syntax highlighting, document formatting, diagnostics, outline symbols, definition navigation, references, and snippets.",
  "version": "0.1.0",
  "publisher": "tommo",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:swirl"
  ],
  "main": "./client/out/extension",
  "contributes": {
    "languages": [
      {
        "id": "swirl",
        "aliases": [
          "Swirl",
          "swirl"
        ],
        "extensions": [
          ".swirl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "swirl",
        "scopeName": "source.swirl",
        "path": "./syntaxes/swirl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "swirl",
        "path": "./snippets/swirl.json"
      }
    ],
    "commands": [
      {
        "command": "swirl.formatDocument",
        "title": "Format Swirl Document",
        "category": "Swirl"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile && pnpm run bundle",
    "compile": "tsc -b client server",
    "watch": "tsc -b client server -w",
    "bundle": "esbuild client/src/extension.ts --bundle --outfile=client/out/extension.js --external:vscode --platform=node --format=cjs && esbuild server/src/server.ts --bundle --outfile=server/out/server.js --platform=node --format=cjs",
    "package": "vsce package --no-dependencies",
    "test": "node server/out/test/formatter.test.js && node server/out/test/features.test.js"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.3.3"
  }
}
