{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Swirl",
  "scopeName": "source.swirl",
  "patterns": [
    {
      "include": "#compiler-hints"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#collections"
    },
    {
      "include": "#guards"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#predicates"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#delimiters"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "compiler-hints": {
      "patterns": [
        {
          "begin": "(\\/\\/\\s*(?:\\[compiler\\](?:\\([^)]*\\))?|@compiler_hint_(?:start|end)|@compiler))(?=\\s|$)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.swirl"
            }
          },
          "end": "$",
          "patterns": [
            {
              "name": "keyword.control.swirl",
              "match": "\\b(begin|end)\\b"
            },
            {
              "name": "entity.name.tag.swirl",
              "match": "\\b(gather_stream|scatter_stream|[a-zA-Z0-9_]+\\.[a-zA-Z0-9_]+)\\b"
            },
            {
              "include": "#variables"
            },
            {
              "name": "meta.embedded.json.swirl string.unquoted.swirl",
              "match": "\\{.*\\}"
            },
            {
              "name": "entity.name.type.location.swirl",
              "match": "\\bl[0-9]+\\b"
            },
            {
              "name": "constant.numeric.region.swirl",
              "match": "\\b[0-9]+\\b"
            },
            {
              "include": "#delimiters"
            },
            {
              "name": "variable.parameter.swirl",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.swirl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.swirl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.swirl",
          "match": "\\?[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "collections": {
      "patterns": [
        {
          "name": "support.function.collection.swirl",
          "match": "\\bU(?=\\s*\\()"
        }
      ]
    },
    "guards": {
      "patterns": [
        {
          "name": "keyword.operator.guard.swirl",
          "match": "\\bhas\\s+data(?:\\s+in)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.swirl",
          "match": "\\b(begin|eof|in|has)\\b"
        },
        {
          "name": "constant.language.scope.swirl",
          "match": "\\broot\\b"
        }
      ]
    },
    "predicates": {
      "patterns": [
        {
          "name": "support.function.predicate.swirl",
          "match": "\\b(exec|send|recv|move|end|scatter_send|gather_recv)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.flow.swirl",
          "match": "->"
        },
        {
          "name": "keyword.operator.sequence.swirl",
          "match": "\\."
        },
        {
          "name": "keyword.operator.parallel.swirl",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.choice.swirl",
          "match": "\\+"
        },
        {
          "name": "keyword.operator.replication.swirl",
          "match": "!"
        },
        {
          "name": "keyword.operator.range.swirl",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.path.swirl",
          "match": "/"
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.definition.location.begin.swirl",
          "match": "<"
        },
        {
          "name": "punctuation.definition.location.end.swirl",
          "match": ">"
        },
        {
          "name": "punctuation.section.parens.begin.swirl",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.swirl",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.braces.begin.swirl",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.swirl",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.brackets.begin.swirl",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.swirl",
          "match": "\\]"
        },
        {
          "name": "punctuation.separator.comma.swirl",
          "match": ","
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.swirl",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.identifier.swirl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
