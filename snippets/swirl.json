{
  "Location": {
    "prefix": "loc",
    "body": [
      "<${1:l0}, {${2:(p1, d1)}},",
      "  ${3:trace}",
      ">"
    ],
    "description": "Swirl location definition"
  },
  "Exec Predicate": {
    "prefix": "exec",
    "body": [
      "exec(${1:step}, {${2:(p_in, d_in)}} -> {${3:(p_out, d_out)}}, {${4:location}})"
    ],
    "description": "Swirl exec predicate"
  },
  "Send Predicate": {
    "prefix": "send",
    "body": [
      "send(${1:data} -> ${2:port}, ${3:src}, ${4:dst})"
    ],
    "description": "Swirl send predicate"
  },
  "Recv Predicate": {
    "prefix": "recv",
    "body": [
      "recv(${1:data} -> ${2:port}, ${3:src}, ${4:dst})"
    ],
    "description": "Swirl recv predicate"
  },
  "Move Predicate": {
    "prefix": "move",
    "body": [
      "move(${1:data} -> ${2:port}, ${3:src}, ${4:dst})"
    ],
    "description": "Swirl move predicate"
  },
  "End Predicate": {
    "prefix": "end",
    "body": [
      "end()"
    ],
    "description": "Swirl end() termination primitive"
  },
  "Collection Descriptor": {
    "prefix": "U",
    "body": [
      "U(${1:port}, ${2:data})"
    ],
    "description": "Swirl finite collection descriptor U(port, data)"
  },
  "Move Tuple Predicate": {
    "prefix": "movetuple",
    "body": [
      "move((${1:id}, ${2:payload}) -> ${3:port}, ${4:src}, ${5:dst})"
    ],
    "description": "Swirl move predicate with data tuple"
  },
  "Recv Tuple Predicate": {
    "prefix": "recvtuple",
    "body": [
      "recv((${1:id}, ${2:payload}) -> ${3:port}, ${4:src}, ${5:dst})"
    ],
    "description": "Swirl recv predicate with data tuple"
  },
  "Data Tuple": {
    "prefix": "tuple",
    "body": [
      "(${1:id}, ${2:payload})"
    ],
    "description": "Swirl data tuple"
  },
  "Replication": {
    "prefix": "repl",
    "body": [
      "!(",
      "  ${1:trace}",
      ")"
    ],
    "description": "Swirl replication block"
  },
  "Choice": {
    "prefix": "choice",
    "body": [
      "(",
      "  ${1:branch1}",
      ")",
      "+",
      "(",
      "  ${2:branch2}",
      ")"
    ],
    "description": "Swirl choice block"
  },
  "Guarded Choice": {
    "prefix": "gchoice",
    "body": [
      "(",
      "  ${1:branch1}",
      ")",
      "+[${2:port} has data]",
      "(",
      "  ${3:branch2}",
      ")"
    ],
    "description": "Swirl guarded choice block"
  },
  "Scatter Stream Hint": {
    "prefix": "scatter_stream",
    "body": [
      "// @compiler begin scatter_stream ${1:stream_collection} ${2:location} ${3:port}",
      "(",
      "  !(",
      "    (",
      "      move((${4:?element}, ${5:?key}) -> ${3:port}, ${6:l0}, ${2:location})",
      "    )",
      "    +[${3:port} has data]",
      "    (",
      "      end()",
      "    )",
      "  )",
      "  .",
      "  send(eof -> ${3:port}, ${6:l0}, ${2:location})",
      ")",
      "// @compiler end scatter_stream ${1:stream_collection} ${2:location} ${3:port}"
    ],
    "description": "Swirl scatter stream block with compiler hints"
  },
  "Gather Stream Hint": {
    "prefix": "gather_stream",
    "body": [
      "// @compiler begin gather_stream ${1:results_collection} ${2:worker} ${3:port}",
      "(",
      "  !(",
      "    (",
      "      recv((${4:?output}, ${5:?key}) -> ${3:port}, ${2:worker}, ${6:l0})",
      "    )",
      "    +",
      "    (",
      "      recv(eof -> ${3:port}, ${2:worker}, ${6:l0})",
      "      .",
      "      end()",
      "    )",
      "  )",
      ")",
      "// @compiler end gather_stream ${1:results_collection} ${2:worker} ${3:port}"
    ],
    "description": "Swirl gather stream block with compiler hints"
  },
  "Scatter Worker Hint": {
    "prefix": "scatter_worker",
    "body": [
      "// @compiler begin scatter.worker ${1:0}",
      "${2:body}",
      "// @compiler end scatter.worker ${1:0}"
    ],
    "description": "Swirl scatter worker block with compiler hint"
  }
}
